// Prisma schema for the reimbursement app.
// Migrations and the generated client live alongside this file.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  APPROVER
  /// Office admin: enters company expenses (paper invoices) into the ledger.
  ADMIN
}

enum BundleStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  REJECTED
}

model User {
  id                         String   @id @default(cuid())
  name                       String
  role                       Role     @default(EMPLOYEE)
  initials                   String
  /// Central HF-ID badge (the OIDC `sub`). Lets a signed card assertion from the
  /// HF-ID service resolve to this app's internal User. Optional + unique: a badge
  /// maps to at most one employee, and rows without a badge simply can't card-login.
  badge                      String?  @unique
  lineId                     String?  @unique
  lineDisplayName            String?
  linePictureUrl             String?
  /// 6-digit numeric code an admin generates so the user can bind their LINE id on first login.
  lineLinkingCode            String?  @unique
  lineLinkingCodeGeneratedAt DateTime?
  createdAt                  DateTime @default(now())

  receipts        Receipt[]
  bundlesOwned    Bundle[]  @relation("submitter")
  bundlesApproved Bundle[]  @relation("approver")
  auditEvents     AuditEvent[]
  expensesEntered Expense[]

  @@map("users")
}

/// A company expense entered by the office admin from a (usually paper)
/// invoice — the ledger side of the P&L. Reimbursed staff purchases stay
/// in `Receipt`; the monthly rollup merges both via the shared
/// category → P&L-line mapping.
model Expense {
  id          String   @id @default(cuid())
  enteredById String
  /// Restrict (not Cascade): ledger rows are financial history and must
  /// survive user-account cleanup.
  enteredBy   User     @relation(fields: [enteredById], references: [id], onDelete: Restrict)
  /// P&L line code from the shared PL_LINES list (e.g. "elec_saichon").
  /// Plain string so new lines don't need a migration.
  plLine      String
  /// Accrual month this expense belongs to on the P&L: "YYYY-MM".
  expenseMonth String
  /// Date printed on the invoice, "YYYY-MM-DD"; null when unreadable/absent.
  invoiceDate String?
  /// Free-text billing-period annotation for utility bills (e.g. "มี.ค. 69").
  billingPeriod String?
  vendor      String   @default("")
  amount      Decimal  @db.Decimal(12, 2)
  /// "cash" | "transfer" — how the company paid. Staff-paid invoices become
  /// Receipts (reimbursement flow) instead of Expense rows.
  paymentMethod String @default("transfer")
  /// False = invoice received but not yet paid (accounts payable).
  paid        Boolean  @default(true)
  /// Payment due date for unpaid invoices, "YYYY-MM-DD".
  dueDate     String?
  note        String?
  /// URL path to the uploaded invoice photo (e.g. "/uploads/abc.jpg").
  photoPath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseMonth])
  @@index([plLine])
  @@map("expenses")
}

/// Monthly revenue figures for the P&L report (one row per month) —
/// admin-entered from the front-desk numbers until an analytics feed exists.
model RevenueEntry {
  id        String   @id @default(cuid())
  /// "YYYY-MM"
  month     String   @unique
  rooms     Decimal  @default(0) @db.Decimal(12, 2)
  waterBar  Decimal  @default(0) @db.Decimal(12, 2)
  other     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("revenue_entries")
}

model Receipt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   String
  category   String
  /// Which property this expense is for. "hf-hotel" or "hf-ville".
  property   String   @default("hf-hotel")
  /// Optional unit count (จำนวนชิ้น) — e.g. "4 croissants" — null when not relevant.
  quantity   Int?
  amount     Decimal  @db.Decimal(12, 2)
  date       String   // YYYY-MM-DD as plain string for display fidelity
  note       String?
  color      String   @default("#F5EBD9")
  accent     String   @default("#7E5E3A")
  items      Json     @default("[]") // ReceiptItem[]
  tax        String   @default("0")
  photoPath  String?
  bundleId   String?
  bundle     Bundle?  @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([bundleId])
  @@map("receipts")
}

model Bundle {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation("submitter", fields: [userId], references: [id], onDelete: Cascade)
  name               String
  status             BundleStatus @default(PENDING)
  submittedAt        DateTime     @default(now())
  approvedAt         DateTime?
  approvedById       String?
  approver           User?        @relation("approver", fields: [approvedById], references: [id], onDelete: SetNull)
  paidAt             DateTime?
  transferRef        String?
  transferAmount     Decimal?     @db.Decimal(12, 2)
  transferProofPath  String?
  note               String       @default("")
  rejectReason       String?
  createdAt          DateTime     @default(now())

  receipts     Receipt[]
  auditEvents  AuditEvent[]

  @@index([userId])
  @@index([status])
  @@map("bundles")
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String   // submit, approve, reject, pay, edit, etc.
  bundleId  String?
  bundle    Bundle?  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([bundleId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}
