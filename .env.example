# ===========================================
# Environment Variables for Reimbursement App
# ===========================================
# Copy to .env for local dev (the API loads from this).

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reimbursement

# API server
API_PORT=3001
UPLOADS_DIR=./apps/api/uploads

# Frontend
WEB_PORT=5173

# Auth
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-please
JWT_EXPIRY_HOURS=24

# LINE OAuth (shared channel with fingerprint-time-logger)
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
# Where the LINE callback lands. Must be registered in LINE Developers console.
# Path is NextAuth-style (/api/auth/callback/<provider>) so we can reuse the
# URL already registered for the legacy reimbursement app's channel.
LINE_REDIRECT_URI=http://localhost:5173/api/auth/callback/line

# Where to redirect after auth (frontend base URL)
WEB_BASE_URL=http://localhost:5173

# ── NFC staff-card login (central HF-ID service) ──────────────────────────────
# Server-to-server secret presented to the HF-ID reader-claim endpoint
# (X-Reader-Secret). Card login fails closed (503) until this is set.
READER_RESOLVE_SECRET=
# Base URL of the central HF-ID service. Default is the evergreen LAN IP, which
# is reachable from the api container. JWKS is fetched from {BASE}/oidc/jwks.
HF_ID_BASE_URL=http://192.168.100.228:5000
# Expected `iss` claim on the RS256 card assertion (public issuer, not the LAN URL).
HF_ID_ISSUER=https://id.thehfhotel.org/oidc
